#!/bin/sh
if [ ! -f tools/check_build_inputs.py ]; then
    echo "Build guard missing: restore tools/check_build_inputs.py." >&2
    exit 1
fi
for py in python3 python; do
    if "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' </dev/null >/dev/null 2>&1; then
        exec "$py" tools/check_build_inputs.py --pre-push --release
    fi
done
echo "Build guard requires Python 3.10+ on PATH." >&2
exit 1
