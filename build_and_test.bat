@echo off
setlocal
cd /d "%~dp0"

rem =========================================================================
rem  build_and_test.bat - thin wrapper. Delegates to build_and_test_ninja.bat.
rem
rem  This file MUST stay pure ASCII: cmd.exe decodes .bat with the local
rem  codepage, GBK on zh-CN Windows, so UTF-8 text here turns into mojibake
rem  and may even be executed as a command.
rem
rem  WHY THIS FILE NO LONGER COMPILES ANYTHING ITSELF
rem  ------------------------------------------------
rem  It used to carry a fallback loop over kernel\*.c, used when ninja.exe was
rem  absent. That path was broken three ways and nobody noticed, because
rem  ninja.exe ships in the repo root so it never ran:
rem
rem    1. It linked in alphabetical order. This kernel is LINK-ORDER
rem       SENSITIVE: alphabetical order boots through the self-test and then
rem       HANGS before reaching the shell. Only the explicit order in
rem       build.ninja is known good.
rem    2. It never built rust/ezos_zig/ezos_zig.o or libezos_rs.a, both of
rem       which sit in the link list, so the link failed outright with
rem       undefined references. The fallback could not produce a kernel at
rem       all, ever.
rem    3. Its CFLAGS lacked -Werror and the three -fno-align-* flags, so even
rem       a successful build would not have produced the same bytes as
rem       build.ninja.
rem
rem  It also invoked ninja with -f build.ninja, whose toolchain paths are
rem  hardcoded to D:/MyOS and C:/Users/admin, defeating the drive-letter
rem  detection this file used to do. build_auto.ninja, generated by
rem  tools\gen_ninja.py from build.ninja, is the portable one.
rem
rem  Two build entry points that can drift apart are worse than one. There is
rem  now a single implementation.
rem =========================================================================

set "ARG=%~1"

if /i "%ARG%"=="clean" goto clean

echo ============================================
echo Building Cerulia...
echo ============================================

if /i "%ARG%"=="build-only" goto build_only
if /i "%ARG%"=="no-run" goto build_only

call "%~dp0build_and_test_ninja.bat"
if errorlevel 1 goto error
goto end

:build_only
echo build-only mode: QEMU not launched.
call "%~dp0build_and_test_ninja.bat" build-only
if errorlevel 1 goto error
pause
exit /b 0

:clean
echo cleaning build artifacts...
del /q boot\boot.bin boot\stage2.bin boot\kernel_entry.o boot\task_switch.o kernel\*.o kernel_raw.bin kernel.bin os-image.bin 2>nul
echo clean done.
echo NOTE: build_auto.ninja is generated by tools\gen_ninja.py, not deleted.
pause
exit /b 0

:error
echo.
echo build failed. check errors above.
pause
exit /b 1

:end
endlocal
